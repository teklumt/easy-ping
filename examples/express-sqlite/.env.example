# Everything here is optional; the example runs with no .env at all.

# Unset, a random one is generated on every start. For anything longer-lived:
# openssl rand -base64 32
NOTIFY_SECRET=

# Unset, a pair is generated on first start and kept in .vapid-keys.json. Never rotate them:
# a new pair silently invalidates every browser subscription you already have.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Defaults to easy-ping.db in this folder. Use :memory: to start empty every time.
SQLITE_PATH=
