{
  "name": "easy-ping-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "docs:dev": "pnpm --filter easy-ping-docs dev",
    "docs:build": "pnpm --filter easy-ping-docs build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "type-budget": "turbo run type-budget",
    "lint": "biome check .",
    "format": "biome check --write .",
    "version-packages": "changeset version && git checkout -- examples/express-sqlite/package.json examples/hono-react/package.json examples/next-drizzle/package.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "turbo": "^2.11.10",
    "typescript": "^5.7.0"
  }
}
