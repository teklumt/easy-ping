# Any Postgres. This one is the repo's docker compose: `docker compose up -d postgres` from the root.
DATABASE_URL=postgres://easyping:easyping@localhost:54329/easyping_test

# Signs unsubscribe and other session-less links.
# At least 16 characters and not a placeholder: openssl rand -base64 32
NOTIFY_SECRET=

# Protects POST /api/notifications/cron. Without it that route is a free
# flush-everything trigger against your email provider.
NOTIFY_CRON_SECRET=

# Optional. Without it, emails go to an outbox the page shows instead of being sent.
RESEND_API_KEY=
RESEND_FROM=Acme <notifications@acme.dev>

# Optional. Unset, a pair is generated on first start and kept in .vapid-keys.json. Never rotate
# them: a new pair silently invalidates every browser subscription you already have.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
