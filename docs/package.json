{
  "name": "easy-ping-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Documentation site for easy-ping",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teklumt/easy-ping.git",
    "directory": "docs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "node scripts/generate-llms.mjs && vite",
    "build": "node scripts/generate-llms.mjs && node scripts/check-docs.mjs && tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "og": "node scripts/generate-og.mjs",
    "check-docs": "node scripts/generate-llms.mjs && node scripts/check-docs.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@mdx-js/rollup": "^3.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "remark-gfm": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.7"
  }
}
