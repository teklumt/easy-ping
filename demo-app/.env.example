# postgres | mongodb — the same demo, either database
DB_DRIVER=postgres

DATABASE_URL=postgres://easynotify:easynotify@localhost:54329/easynotify_test
MONGO_URL=mongodb://localhost:27019/?replicaSet=rs0
MONGO_DB=easynotify_demo

NOTIFY_SECRET=demo-signing-secret
NOTIFY_CRON_SECRET=demo-cron-secret
# Generate with: pnpm --filter easy-notify-demo keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
