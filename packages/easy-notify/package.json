{
  "name": "easy-notify",
  "version": "0.0.0",
  "description": "Self-hosted, type-safe notifications for TypeScript apps. Your database, your users.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapters/drizzle": {
      "types": "./dist/adapters/drizzle.d.ts",
      "import": "./dist/adapters/drizzle.js",
      "require": "./dist/adapters/drizzle.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./package.json": "./package.json",
    "./providers/resend": {
      "types": "./dist/providers/resend.d.ts",
      "import": "./dist/providers/resend.js",
      "require": "./dist/providers/resend.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./plugins/preferences": {
      "types": "./dist/plugins/preferences.d.ts",
      "import": "./dist/plugins/preferences.js",
      "require": "./dist/plugins/preferences.cjs"
    },
    "./plugins/preferences/client": {
      "types": "./dist/plugins/preferences-client.d.ts",
      "import": "./dist/plugins/preferences-client.js",
      "require": "./dist/plugins/preferences-client.cjs"
    },
    "./plugins/preferences/react": {
      "types": "./dist/plugins/preferences-react.d.ts",
      "import": "./dist/plugins/preferences-react.js",
      "require": "./dist/plugins/preferences-react.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    }
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.36.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "type-budget": "node scripts/check-type-budget.mjs",
    "check-node-floor": "node scripts/check-node-floor.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  }
}
